From 2d4f5e9d0fb814a8c6d177f1a86a3c72d04c5e5a Mon Sep 17 00:00:00 2001
From: Evan Almloff <evanalmloff@gmail.com>
Date: Fri, 29 May 2026 15:46:00 -0500
Subject: [PATCH 5/5] Store JsFuture callbacks before attaching then

---
 crates/js-sys/src/futures/mod.rs | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/crates/js-sys/src/futures/mod.rs b/crates/js-sys/src/futures/mod.rs
index 5e9e99c8c..b3895f8e6 100644
--- a/crates/js-sys/src/futures/mod.rs
+++ b/crates/js-sys/src/futures/mod.rs
@@ -93,10 +93,10 @@ pub fn spawn_local<F>(future: F)
 struct Inner<T = JsValue> {
     result: Option<Result<T, JsValue>>,
     task: Option<Waker>,
-    callbacks: Option<(
+    callbacks: Option<Rc<(
         Closure<dyn FnMut(T) -> Result<(), JsError>>,
         Closure<dyn FnMut(JsValue) -> Result<(), JsError>>,
-    )>,
+    )>>,
 }
 
 /// A Rust `Future` backed by a JavaScript `Promise`.
@@ -195,9 +195,10 @@ impl<T: FromWasmAbi + 'static> From<Promise<T>> for JsFuture<T> {
             })
         };
 
-        let _ = js.then_with_reject(&resolve, &reject);
+        let callbacks = Rc::new((resolve, reject));
+        state.borrow_mut().callbacks = Some(callbacks.clone());
 
-        state.borrow_mut().callbacks = Some((resolve, reject));
+        let _ = js.then_with_reject(&callbacks.as_ref().0, &callbacks.as_ref().1);
 
         JsFuture { inner: state }
     }
