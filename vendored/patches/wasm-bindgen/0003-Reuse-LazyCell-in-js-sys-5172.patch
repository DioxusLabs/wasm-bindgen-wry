From aa7fc36a46ac680b138de438f97f18b37e3a4750 Mon Sep 17 00:00:00 2001
From: Evan Almloff <evanalmloff@gmail.com>
Date: Wed, 10 Jun 2026 10:14:27 -0500
Subject: [PATCH 03/12] Reuse LazyCell in js-sys (#5172)

---
 crates/test/src/rt/criterion/baseline.rs        | 10 ++++++----
 crates/test/src/rt/criterion/stats/rand_util.rs |  2 +-
 2 files changed, 7 insertions(+), 5 deletions(-)

diff --git a/crates/test/src/rt/criterion/baseline.rs b/crates/test/src/rt/criterion/baseline.rs
index b9249c224..1f8b4cbe7 100644
--- a/crates/test/src/rt/criterion/baseline.rs
+++ b/crates/test/src/rt/criterion/baseline.rs
@@ -26,12 +26,14 @@ pub(crate) struct BenchmarkBaseline {
 
 /// Write the corresponding benchmark ID and corresponding data into the table.
 pub(crate) fn write(id: &str, baseline: BenchmarkBaseline) {
-    BASELINE.borrow_mut().insert(id.into(), baseline);
+    LazyCell::force(&BASELINE)
+        .borrow_mut()
+        .insert(id.into(), baseline);
 }
 
 /// Read the data corresponding to the benchmark ID from the table.
 pub(crate) fn read(id: &str) -> Option<BenchmarkBaseline> {
-    BASELINE.borrow().get(id).cloned()
+    LazyCell::force(&BASELINE).borrow().get(id).cloned()
 }
 
 /// Used to write previous benchmark data before the benchmark, for later comparison.
@@ -39,7 +41,7 @@ pub(crate) fn read(id: &str) -> Option<BenchmarkBaseline> {
 pub fn __wbgbench_import(baseline: Vec<u8>) {
     match serde_json::from_slice(&baseline) {
         Ok(prev) => {
-            *BASELINE.borrow_mut() = prev;
+            *LazyCell::force(&BASELINE).borrow_mut() = prev;
         }
         Err(e) => {
             console_log!("Failed to import previous benchmark {e:?}");
@@ -50,7 +52,7 @@ pub fn __wbgbench_import(baseline: Vec<u8>) {
 /// Used to read benchmark data, and then the runner stores it on the local disk.
 #[wasm_bindgen]
 pub fn __wbgbench_dump() -> Option<Vec<u8>> {
-    let baseline = BASELINE.borrow();
+    let baseline = LazyCell::force(&BASELINE).borrow();
     if baseline.is_empty() {
         return None;
     }
diff --git a/crates/test/src/rt/criterion/stats/rand_util.rs b/crates/test/src/rt/criterion/stats/rand_util.rs
index 048edd65a..c40f30ede 100644
--- a/crates/test/src/rt/criterion/stats/rand_util.rs
+++ b/crates/test/src/rt/criterion/stats/rand_util.rs
@@ -16,7 +16,7 @@ static SEED_RAND: LazyCell<RefCell<Rand64>> = LazyCell::new(|| {
 });
 
 pub fn new_rng() -> Rng {
-    let mut r = SEED_RAND.borrow_mut();
+    let mut r = LazyCell::force(&SEED_RAND).borrow_mut();
     let seed = ((r.rand_u64() as u128) << 64) | (r.rand_u64() as u128);
     Rand64::new(seed)
 }
-- 
