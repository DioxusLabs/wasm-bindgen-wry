From a53975f1c59abbe1c7c43a7536ac8c07409f0659 Mon Sep 17 00:00:00 2001
From: Evan Almloff <evanalmloff@gmail.com>
Date: Wed, 10 Jun 2026 00:00:00 -0500
Subject: [PATCH 7/9] Rename generated sys crates to wry packages

---
 crates/futures/Cargo.toml          | 7 +++++--
 crates/js-sys/Cargo.toml           | 3 ++-
 crates/macro/Cargo.toml            | 6 +++---
 crates/msrv/lib/Cargo.toml         | 6 +++---
 crates/msrv/resolver/Cargo.toml    | 6 +++---
 crates/test/Cargo.toml             | 6 +++---
 crates/test/sample/Cargo.toml      | 4 ++--
 crates/typescript-tests/Cargo.toml | 6 +++---
 crates/web-sys/Cargo.toml          | 5 +++--
 crates/webidl-tests/Cargo.toml     | 4 ++--
 10 files changed, 29 insertions(+), 24 deletions(-)

diff --git a/crates/futures/Cargo.toml b/crates/futures/Cargo.toml
index 8fb1e6ec2..2afd9f094 100644
--- a/crates/futures/Cargo.toml
+++ b/crates/futures/Cargo.toml
@@ -6,7 +6,7 @@ edition = "2021"
 homepage = "https://wasm-bindgen.github.io/wasm-bindgen/"
 include = ["/LICENSE-*", "/src"]
 license = "MIT OR Apache-2.0"
-name = "wasm-bindgen-futures"
+name = "wasm-bindgen-futures-wry"
 readme = "./README.md"
 repository = "https://github.com/wasm-bindgen/wasm-bindgen/tree/master/crates/futures"
 rust-version = "1.77"
@@ -16,8 +16,11 @@ version = "0.4.73"
 all-features = true
 rustdoc-args = ["--cfg", "docsrs"]
 
+[lib]
+name = "wasm_bindgen_futures"
+
 [dependencies]
-js-sys = { path = "../js-sys", package = "js-sys", default-features = false }
+js-sys = { path = "../js-sys", package = "js-sys-wry", default-features = false }
 wasm-bindgen = { path = "../../../../packages/wasm-bindgen", package = "wasm-bindgen", default-features = false }
 
 [features]
diff --git a/crates/js-sys/Cargo.toml b/crates/js-sys/Cargo.toml
index 953864cb8..a1aed592b 100644
--- a/crates/js-sys/Cargo.toml
+++ b/crates/js-sys/Cargo.toml
@@ -10,13 +10,14 @@ edition = "2021"
 homepage = "https://wasm-bindgen.github.io/wasm-bindgen/"
 include = ["/LICENSE-*", "/src"]
 license = "MIT OR Apache-2.0"
-name = "js-sys"
+name = "js-sys-wry"
 readme = "./README.md"
 repository = "https://github.com/wasm-bindgen/wasm-bindgen/tree/master/crates/js-sys"
 rust-version = "1.77"
 version = "0.3.100"
 
 [lib]
+name = "js_sys"
 doctest = false
 test = false
 
diff --git a/crates/macro/Cargo.toml b/crates/macro/Cargo.toml
index d7675a2da..c8bc30c4a 100644
--- a/crates/macro/Cargo.toml
+++ b/crates/macro/Cargo.toml
@@ -24,11 +24,11 @@ quote = "1.0"
 wasm-bindgen-macro-support = { path = "../macro-support", version = "=0.2.123" }
 
 [dev-dependencies]
-js-sys = { path = "../js-sys" }
+js-sys = { path = "../js-sys", package = "js-sys-wry" }
 trybuild = "1.0"
 wasm-bindgen = { path = "../../../../packages/wasm-bindgen", package = "wasm-bindgen" }
-wasm-bindgen-futures = { path = "../futures" }
-web-sys = { path = "../web-sys", features = ["Worker"] }
+wasm-bindgen-futures = { path = "../futures", package = "wasm-bindgen-futures-wry" }
+web-sys = { path = "../web-sys", package = "web-sys-wry", features = ["Worker"] }
 
 [lints]
 workspace = true
diff --git a/crates/msrv/lib/Cargo.toml b/crates/msrv/lib/Cargo.toml
index 16d5f22b3..0e23c331d 100644
--- a/crates/msrv/lib/Cargo.toml
+++ b/crates/msrv/lib/Cargo.toml
@@ -14,11 +14,11 @@ default = [
 ]
 
 [dependencies]
-js-sys = { path = "../../js-sys", default-features = false }
+js-sys = { path = "../../js-sys", package = "js-sys-wry", default-features = false }
 wasm-bindgen = { path = "../../../", default-features = false }
-wasm-bindgen-futures = { path = "../../futures", default-features = false }
+wasm-bindgen-futures = { path = "../../futures", package = "wasm-bindgen-futures-wry", default-features = false }
 wasm-bindgen-test = { path = "../../test", default-features = false }
-web-sys = { path = "../../web-sys", default-features = false }
+web-sys = { path = "../../web-sys", package = "web-sys-wry", default-features = false }
 
 # Pinned sub-dependencies for MSRV
 bumpalo = "=3.12.0"
diff --git a/crates/msrv/resolver/Cargo.toml b/crates/msrv/resolver/Cargo.toml
index 8a29eb38a..99492f6ec 100644
--- a/crates/msrv/resolver/Cargo.toml
+++ b/crates/msrv/resolver/Cargo.toml
@@ -15,11 +15,11 @@ default = [
 ]
 
 [dependencies]
-js-sys = { path = "../../js-sys", default-features = false }
+js-sys = { path = "../../js-sys", package = "js-sys-wry", default-features = false }
 wasm-bindgen = { path = "../../../", default-features = false }
-wasm-bindgen-futures = { path = "../../futures", default-features = false }
+wasm-bindgen-futures = { path = "../../futures", package = "wasm-bindgen-futures-wry", default-features = false }
 wasm-bindgen-test = { path = "../../test", default-features = false }
-web-sys = { path = "../../web-sys", default-features = false }
+web-sys = { path = "../../web-sys", package = "web-sys-wry", default-features = false }
 
 # Pinned sub-dependencies for MSRV
 bumpalo = "=3.12.0"
diff --git a/crates/test/Cargo.toml b/crates/test/Cargo.toml
index fee6a88f3..682a718ee 100644
--- a/crates/test/Cargo.toml
+++ b/crates/test/Cargo.toml
@@ -15,9 +15,9 @@ std = ["wasm-bindgen/std", "js-sys/std", "wasm-bindgen-futures/std"]
 
 [dependencies]
 gg-alloc = { version = "1.0", optional = true }
-js-sys = { path = '../js-sys', version = '=0.3.100', default-features = false }
+js-sys = { path = '../js-sys', package = "js-sys-wry", version = '=0.3.100', default-features = false }
 wasm-bindgen = { path = "../../../../packages/wasm-bindgen", package = "wasm-bindgen", default-features = false }
-wasm-bindgen-futures = { path = '../futures', version = '=0.4.73', default-features = false }
+wasm-bindgen-futures = { path = '../futures', package = "wasm-bindgen-futures-wry", version = '=0.4.73', default-features = false }
 wasm-bindgen-test-macro = { path = '../test-macro', version = '=0.3.73' }
 wasm-bindgen-test-shared = { path = "../test-shared", version = "=0.2.123" }
 
@@ -36,7 +36,7 @@ serde_json = { version = "1.0", default-features = false, features = ["alloc"] }
 minicov = "0.3.8"
 
 [dev-dependencies]
-web-sys = { path = "../web-sys", features = [
+web-sys = { path = "../web-sys", package = "web-sys-wry", features = [
   "Blob",
   "BlobPropertyBag",
   "ErrorEvent",
diff --git a/crates/test/sample/Cargo.toml b/crates/test/sample/Cargo.toml
index e6d8ea5de..95857c084 100644
--- a/crates/test/sample/Cargo.toml
+++ b/crates/test/sample/Cargo.toml
@@ -9,9 +9,9 @@ version = "0.0.0"
 test = false
 
 [dependencies]
-js-sys = { path = '../../js-sys' }
+js-sys = { path = '../../js-sys', package = "js-sys-wry" }
 wasm-bindgen = { path = '../../..' }
-wasm-bindgen-futures = { path = '../../futures' }
+wasm-bindgen-futures = { path = '../../futures', package = "wasm-bindgen-futures-wry" }
 
 [dev-dependencies]
 wasm-bindgen-test = { path = '..' }
diff --git a/crates/typescript-tests/Cargo.toml b/crates/typescript-tests/Cargo.toml
index 1bd464ffb..c94443104 100644
--- a/crates/typescript-tests/Cargo.toml
+++ b/crates/typescript-tests/Cargo.toml
@@ -6,12 +6,12 @@ publish = false
 version = "0.0.0"
 
 [dependencies]
-js-sys = { path = '../js-sys' }
+js-sys = { path = '../js-sys', package = "js-sys-wry" }
 serde = { version = "1.0", features = ["derive"] }
 serde-wasm-bindgen = "0.6"
 wasm-bindgen = { path = '../..' }
-wasm-bindgen-futures = { path = '../futures' }
-web-sys = { path = '../web-sys', features = ['HtmlElement', 'Node', 'Document'] }
+wasm-bindgen-futures = { path = '../futures', package = "wasm-bindgen-futures-wry" }
+web-sys = { path = '../web-sys', package = "web-sys-wry", features = ['HtmlElement', 'Node', 'Document'] }
 
 [lib]
 crate-type = ['cdylib']
diff --git a/crates/web-sys/Cargo.toml b/crates/web-sys/Cargo.toml
index 68bc3b8ea..844bc7bb3 100644
--- a/crates/web-sys/Cargo.toml
+++ b/crates/web-sys/Cargo.toml
@@ -8,7 +8,7 @@ edition = "2021"
 homepage = "https://wasm-bindgen.github.io/wasm-bindgen/web-sys/index.html"
 include = ["/LICENSE-*", "/src"]
 license = "MIT OR Apache-2.0"
-name = "web-sys"
+name = "web-sys-wry"
 readme = "./README.md"
 repository = "https://github.com/wasm-bindgen/wasm-bindgen/tree/master/crates/web-sys"
 rust-version = "1.77"
@@ -19,11 +19,12 @@ all-features = true
 rustdoc-args = ["--cfg=web_sys_unstable_apis"]
 
 [lib]
+name = "web_sys"
 doctest = false
 test = false
 
 [dependencies]
-js-sys = { path = '../js-sys', package = "js-sys", default-features = false }
+js-sys = { path = '../js-sys', package = "js-sys-wry", default-features = false }
 wasm-bindgen = { path = "../../../../packages/wasm-bindgen", package = "wasm-bindgen", default-features = false }
 
 [lints.rust]
diff --git a/crates/webidl-tests/Cargo.toml b/crates/webidl-tests/Cargo.toml
index ee5683f1e..00ae71f9b 100644
--- a/crates/webidl-tests/Cargo.toml
+++ b/crates/webidl-tests/Cargo.toml
@@ -11,9 +11,9 @@ path = 'lib.rs'
 test = false
 
 [dependencies]
-js-sys = { path = '../js-sys', features = ["unsafe-eval"] }
+js-sys = { path = '../js-sys', package = "js-sys-wry", features = ["unsafe-eval"] }
 wasm-bindgen = { path = '../..' }
-wasm-bindgen-futures = { path = '../futures' }
+wasm-bindgen-futures = { path = '../futures', package = "wasm-bindgen-futures-wry" }
 
 [build-dependencies]
 env_logger = "0.11"
