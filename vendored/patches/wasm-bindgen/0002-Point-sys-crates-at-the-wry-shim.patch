From c9ec9b6d6b103b394c3e9f835aedd1a29b5332b4 Mon Sep 17 00:00:00 2001
From: Evan Almloff <evanalmloff@gmail.com>
Date: Fri, 29 May 2026 10:57:02 -0500
Subject: [PATCH 02/10] Point sys crates at the wry shim

---
 crates/futures/Cargo.toml |  9 ++-------
 crates/js-sys/Cargo.toml  | 10 +---------
 crates/macro/Cargo.toml   |  2 +-
 crates/shared/Cargo.toml  |  5 -----
 crates/test/Cargo.toml    |  2 +-
 crates/web-sys/Cargo.toml |  9 ++-------
 crates/web-sys/src/lib.rs |  2 +-
 7 files changed, 8 insertions(+), 31 deletions(-)

diff --git a/crates/futures/Cargo.toml b/crates/futures/Cargo.toml
index 78ba5fc8d..8fb1e6ec2 100644
--- a/crates/futures/Cargo.toml
+++ b/crates/futures/Cargo.toml
@@ -17,18 +17,13 @@ all-features = true
 rustdoc-args = ["--cfg", "docsrs"]
 
 [dependencies]
-js-sys = { path = "../js-sys", version = "=0.3.100", default-features = false }
-wasm-bindgen = { path = "../..", version = "=0.2.123", default-features = false }
+js-sys = { path = "../js-sys", package = "js-sys", default-features = false }
+wasm-bindgen = { path = "../../../../packages/wasm-bindgen", package = "wasm-bindgen", default-features = false }
 
 [features]
 default = ["std"]
 futures-core-03-stream = ["js-sys/futures-core-03-stream"]
 std = ["wasm-bindgen/std", "js-sys/std"]
 
-[target.'cfg(target_arch = "wasm32")'.dev-dependencies]
-futures-channel = "0.3"
-futures-lite = { version = "2", default-features = false }
-wasm-bindgen-test = { path = '../test' }
-
 [lints]
 workspace = true
diff --git a/crates/js-sys/Cargo.toml b/crates/js-sys/Cargo.toml
index 1d3f1a177..953864cb8 100644
--- a/crates/js-sys/Cargo.toml
+++ b/crates/js-sys/Cargo.toml
@@ -36,15 +36,7 @@ futures-core-03-stream = ["dep:futures-util", "dep:futures-core"]
 cfg-if = "1.0.0"
 futures-core = { version = "0.3.8", default-features = false, optional = true }
 futures-util = { version = "0.3.31", default-features = false, features = ["std"], optional = true }
-wasm-bindgen = { path = "../..", version = "=0.2.123", default-features = false }
-
-[target.'cfg(target_arch = "wasm32")'.dev-dependencies]
-futures-channel = "0.3"
-futures-lite = { version = "2", default-features = false }
-half = "2"
-wasm-bindgen-futures = { path = '../futures' }
-wasm-bindgen-test = { path = '../test' }
-web-sys = { path = "../web-sys", features = ["Headers", "Response", "ResponseInit"] }
+wasm-bindgen = { path = "../../../../packages/wasm-bindgen", package = "wasm-bindgen", default-features = false }
 
 [lints.rust]
 unexpected_cfgs = { level = "warn", check-cfg = ['cfg(js_sys_unstable_apis)'] }
diff --git a/crates/macro/Cargo.toml b/crates/macro/Cargo.toml
index 679ccccd6..d7675a2da 100644
--- a/crates/macro/Cargo.toml
+++ b/crates/macro/Cargo.toml
@@ -26,7 +26,7 @@ wasm-bindgen-macro-support = { path = "../macro-support", version = "=0.2.123" }
 [dev-dependencies]
 js-sys = { path = "../js-sys" }
 trybuild = "1.0"
-wasm-bindgen = { path = "../.." }
+wasm-bindgen = { path = "../../../../packages/wasm-bindgen", package = "wasm-bindgen" }
 wasm-bindgen-futures = { path = "../futures" }
 web-sys = { path = "../web-sys", features = ["Worker"] }
 
diff --git a/crates/shared/Cargo.toml b/crates/shared/Cargo.toml
index 7e640a5ee..17840f103 100644
--- a/crates/shared/Cargo.toml
+++ b/crates/shared/Cargo.toml
@@ -14,11 +14,6 @@ repository = "https://github.com/wasm-bindgen/wasm-bindgen/tree/master/crates/sh
 rust-version = "1.77"
 version = "0.2.123"
 
-# Because only a single `wasm_bindgen` version can be used in a dependency
-# graph, pretend we link a native library so that `cargo` will provide better
-# error messages than the esoteric linker errors we would otherwise trigger.
-links = "wasm_bindgen"
-
 [lints]
 workspace = true
 
diff --git a/crates/test/Cargo.toml b/crates/test/Cargo.toml
index c21310924..fee6a88f3 100644
--- a/crates/test/Cargo.toml
+++ b/crates/test/Cargo.toml
@@ -16,7 +16,7 @@ std = ["wasm-bindgen/std", "js-sys/std", "wasm-bindgen-futures/std"]
 [dependencies]
 gg-alloc = { version = "1.0", optional = true }
 js-sys = { path = '../js-sys', version = '=0.3.100', default-features = false }
-wasm-bindgen = { path = '../..', version = '=0.2.123', default-features = false }
+wasm-bindgen = { path = "../../../../packages/wasm-bindgen", package = "wasm-bindgen", default-features = false }
 wasm-bindgen-futures = { path = '../futures', version = '=0.4.73', default-features = false }
 wasm-bindgen-test-macro = { path = '../test-macro', version = '=0.3.73' }
 wasm-bindgen-test-shared = { path = "../test-shared", version = "=0.2.123" }
diff --git a/crates/web-sys/Cargo.toml b/crates/web-sys/Cargo.toml
index d252d5969..68bc3b8ea 100644
--- a/crates/web-sys/Cargo.toml
+++ b/crates/web-sys/Cargo.toml
@@ -23,13 +23,8 @@ doctest = false
 test = false
 
 [dependencies]
-js-sys = { path = '../js-sys', version = '=0.3.100', default-features = false }
-wasm-bindgen = { path = "../..", version = "=0.2.123", default-features = false }
-
-[target.'cfg(target_arch = "wasm32")'.dev-dependencies]
-futures = "0.3"
-wasm-bindgen-futures = { path = '../futures', features = ["futures-core-03-stream"] }
-wasm-bindgen-test = { path = '../test' }
+js-sys = { path = '../js-sys', package = "js-sys", default-features = false }
+wasm-bindgen = { path = "../../../../packages/wasm-bindgen", package = "wasm-bindgen", default-features = false }
 
 [lints.rust]
 unexpected_cfgs = { level = "warn", check-cfg = ['cfg(web_sys_unstable_apis)'] }
diff --git a/crates/web-sys/src/lib.rs b/crates/web-sys/src/lib.rs
index 38cdb6732..ed019dda5 100644
--- a/crates/web-sys/src/lib.rs
+++ b/crates/web-sys/src/lib.rs
@@ -12,7 +12,7 @@
 //! require.
 
 #![doc(html_root_url = "https://docs.rs/web-sys/0.3")]
-#![no_std]
+// #![no_std]
 #![allow(deprecated)]
 
 extern crate alloc;
-- 
