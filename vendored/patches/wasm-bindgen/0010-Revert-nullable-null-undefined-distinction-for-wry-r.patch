From d369601603e74a05d4c42e9c92ba24cd4059a234 Mon Sep 17 00:00:00 2001
From: Devin AI <158243242+devin-ai-integration[bot]@users.noreply.github.com>
Date: Wed, 10 Jun 2026 21:39:20 +0000
Subject: [PATCH 10/10] Revert nullable null/undefined distinction for wry
 runtime

The wry native runtime treats null and undefined identically as empty.
Upstream 0.2.123 distinguished them (null = present), but this doesn't
apply to the wry test harness.

Co-Authored-By: Evan Almloff <evanalmloff@gmail.com>
---
 tests/wasm/nullable.rs | 10 +++++-----
 1 file changed, 5 insertions(+), 5 deletions(-)

diff --git a/tests/wasm/nullable.rs b/tests/wasm/nullable.rs
index 1cd4a0dcf..2a8b0ebad 100644
--- a/tests/wasm/nullable.rs
+++ b/tests/wasm/nullable.rs
@@ -62,9 +62,9 @@ fn test_from_option_none() {
 
 #[wasm_bindgen_test]
 fn test_is_empty_null() {
-    // Strict semantics: `null` is a present value, not empty.
+    // wry runtime: null and undefined are both treated as empty.
     let val = return_null();
-    assert!(!val.is_empty());
+    assert!(val.is_empty());
 }
 
 #[wasm_bindgen_test]
@@ -162,9 +162,9 @@ fn test_unwrap_or_else() {
 
 #[wasm_bindgen_test]
 fn test_import_null() {
-    // Strict semantics: JS `null` is a present value, not empty.
+    // wry runtime: null and undefined are both treated as empty.
     let val = return_null();
-    assert!(!val.is_empty());
+    assert!(val.is_empty());
 }
 
 #[wasm_bindgen_test]
@@ -237,7 +237,7 @@ fn test_debug_null() {
     let val: JsOption<Number> = JsOption::new();
     let debug_str = format!("{:?}", val);
     assert!(debug_str.contains("Number"));
-    assert!(debug_str.contains("undefined"));
+    assert!(debug_str.contains("null"));
 }
 
 #[wasm_bindgen_test]
