From 785d3bbc8163d31812b32781ee588668908cff30 Mon Sep 17 00:00:00 2001
From: Evan Almloff <evanalmloff@gmail.com>
Date: Fri, 29 May 2026 10:56:07 -0500
Subject: [PATCH 01/10] Prepare root workspace for wry patching

---
 Cargo.toml              | 85 +++++++++--------------------------------
 crates/macro/Cargo.toml |  2 +-
 2 files changed, 18 insertions(+), 69 deletions(-)

diff --git a/Cargo.toml b/Cargo.toml
index 6e98ddd17..a8adeba24 100644
--- a/Cargo.toml
+++ b/Cargo.toml
@@ -9,7 +9,7 @@ edition = "2021"
 homepage = "https://wasm-bindgen.github.io/wasm-bindgen"
 include = ["/build.rs", "/LICENSE-*", "/src"]
 license = "MIT OR Apache-2.0"
-name = "wasm-bindgen"
+name = "not-wasm-bindgen"
 readme = "README.md"
 repository = "https://github.com/wasm-bindgen/wasm-bindgen"
 rust-version = "1.77"
@@ -34,7 +34,7 @@ strict-macro = ["wasm-bindgen-macro/strict-macro"]
 
 # INTERNAL ONLY: Enables gg-alloc as system allocator when using wasm-bindgen-test to check that large pointers
 # are handled correctly
-gg-alloc = ["wasm-bindgen-test/gg-alloc"]
+gg-alloc = []
 
 # Deprecated crate features
 msrv = []
@@ -46,33 +46,13 @@ cfg-if = "1.0.0"
 once_cell = { version = "1.12", default-features = false }
 serde = { version = "1.0", optional = true }
 serde_json = { version = "1.0", optional = true }
-wasm-bindgen-macro = { path = "crates/macro", version = "=0.2.123" }
+wasm-bindgen-macro = { package = "not-wasm-bindgen-macro", path = "crates/macro", version = "=0.2.123" }
 wasm-bindgen-shared = { path = "crates/shared", version = "=0.2.123" }
 
 [build-dependencies]
 # In older MSRVs, dependencies and crate features can't have the same name.
 rustversion-compat = { package = "rustversion", version = "1.0.6" }
 
-[dev-dependencies]
-once_cell = "1"
-wasm-bindgen-test = { path = 'crates/test' }
-
-[target.'cfg(target_arch = "wasm32")'.dev-dependencies]
-js-sys = { path = 'crates/js-sys', features = ["unsafe-eval"] }
-paste = "1"
-serde_derive = "1.0"
-wasm-bindgen-futures = { path = 'crates/futures' }
-wasm-bindgen-test-crate-a = { path = 'tests/crates/a' }
-wasm-bindgen-test-crate-b = { path = 'tests/crates/b' }
-
-[target.'cfg(target_arch = "wasm64")'.dev-dependencies]
-js-sys = { path = 'crates/js-sys', features = ["unsafe-eval"] }
-paste = "1"
-serde_derive = "1.0"
-wasm-bindgen-futures = { path = 'crates/futures' }
-wasm-bindgen-test-crate-a = { path = 'tests/crates/a' }
-wasm-bindgen-test-crate-b = { path = 'tests/crates/b' }
-
 [lints]
 workspace = true
 
@@ -94,58 +74,27 @@ type_complexity = "allow"
 uninlined_format_args = "warn"
 
 [workspace]
-exclude = ["crates/msrv/resolver", "crates/msrv/lib", "crates/msrv/cli"]
-members = [
+exclude = [
   "benchmarks",
-  "benchmarks/wcodspeed",
   "crates/cli",
-  "crates/js-sys",
+  "crates/macro-support",
+  "crates/msrv/resolver",
+  "crates/msrv/lib",
+  "crates/msrv/cli",
+  "crates/shared",
   "crates/test",
   "crates/test/sample",
   "crates/typescript-tests",
-  "crates/web-sys",
   "crates/webidl",
   "crates/webidl-tests",
-  "examples/add",
-  "examples/canvas",
-  "examples/char",
-  "examples/closures",
-  "examples/console_log",
-  "examples/nodejs_and_deno",
-  "examples/nodejs-threads",
-  "examples/dom",
-  "examples/duck-typed-interfaces",
-  "examples/explicit-resource-management",
-  "examples/fetch",
-  "examples/guide-supported-types-examples",
-  "examples/hello_world",
-  "examples/import_js/crate",
-  "examples/julia_set",
-  "examples/paint",
-  "examples/performance",
-  "examples/raytrace-parallel",
-  "examples/request-animation-frame",
-  "examples/todomvc",
-  "examples/wasm-audio-worklet",
-  "examples/wasm-in-wasm",
-  "examples/wasm-in-wasm-imports",
-  "examples/wasm-in-web-worker",
-  "examples/weather_report",
-  "examples/webaudio",
-  "examples/webgl",
-  "examples/webrtc_datachannel",
-  "examples/websockets",
-  "examples/webxr",
-  "examples/without-a-bundler",
-  "examples/without-a-bundler-no-modules",
-  "examples/synchronous-instantiation",
+  "examples/*",
   "tests/no-std",
 ]
+members = [
+  "crates/js-sys",
+  "crates/web-sys",
+  "crates/futures",
+  "crates/test-macro",
+  "crates/test-shared",
+]
 resolver = "2"
-
-[patch.crates-io]
-js-sys = { path = 'crates/js-sys' }
-wasm-bindgen = { path = '.' }
-wasm-bindgen-futures = { path = 'crates/futures' }
-wasm-bindgen-test = { path = 'crates/test' }
-web-sys = { path = 'crates/web-sys' }
diff --git a/crates/macro/Cargo.toml b/crates/macro/Cargo.toml
index c42e7bfc4..679ccccd6 100644
--- a/crates/macro/Cargo.toml
+++ b/crates/macro/Cargo.toml
@@ -8,7 +8,7 @@ edition = "2021"
 homepage = "https://wasm-bindgen.github.io/wasm-bindgen/"
 include = ["/LICENSE-*", "/src"]
 license = "MIT OR Apache-2.0"
-name = "wasm-bindgen-macro"
+name = "not-wasm-bindgen-macro"
 repository = "https://github.com/wasm-bindgen/wasm-bindgen/tree/master/crates/macro"
 rust-version = "1.77"
 version = "0.2.123"
-- 
2.34.1

